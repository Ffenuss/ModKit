<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed to list user-installed games and regular applications. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Required only for explicit user-confirmed installation of repacked test builds. -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:ignore="RequestInstallPackagesPolicy" />

    <!-- Used only to open the system-confirmed removal flow for signature conflicts. -->
    <uses-permission
        android:name="android.permission.REQUEST_DELETE_PACKAGES"
        tools:ignore="RequestDeletePackagesPolicy" />

    <application
        android:allowBackup="false"
        android:largeHeap="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ModKit">
        <!-- Legacy Space host can read only the active, signer/APK-verified,
             inventory-only menu. Caller UID and host signing pins are enforced. -->
        <provider
            android:name=".space.SpaceReadOnlyMenuProvider"
            android:authorities="${applicationId}.space-menu"
            android:exported="true"
            android:grantUriPermissions="false" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Explicit PackageInstaller callback: preserves the current Patch Lab
             screen and receives results without launching a second activity. -->
        <receiver
            android:name=".runtime.RepackedInstallStatusReceiver"
            android:exported="false" />

        <!-- User explicitly enables this Android Accessibility service. It reads
             only a selected numeric node in the selected game's active window
             when the user taps the accessibility overlay capture button. -->
        <service
            android:name=".observation.NativeMetricAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true"
            android:label="@string/native_metric_accessibility_name">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/native_metric_accessibility" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
